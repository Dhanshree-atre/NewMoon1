// Counter Contract
// 
// Privacy Model:
// - PUBLIC: The `counter` state variable is public (on-chain). It stores the current count.
// - PRIVATE: The `amount_to_add` input parameter is a private witness, only known to the user running the transaction.
//            It is never exposed on-chain in its raw form unless intentionally disclosed.
// - We use `disclose()` deliberately to reveal the private `amount_to_add` so it can be added to the public counter.

pragma compact-v0;

export ledger counter: Cell<Uint<32>>;

export circuit increment(amount_to_add: Uint<32>): [] {
    // Deliberately disclose the private witness
    let amount = disclose(amount_to_add);
    
    // Increment the public counter
    let current_val = counter;
    counter = current_val + amount;
}
